# Add this block to your shared Caddyfile on the Hetzner box.
# Caddy auto-provisions HTTPS for the domain.
#
#   /updates/*  -> static files (installers + latest.json, uploaded by CI)
#   everything  -> the dashboard + report API (node server.js on :8787)

patchpilot.bullers.com {
	encode gzip

	handle_path /updates/* {
		root * /var/www/patchpilot/updates
		file_server browse
	}

	handle {
		reverse_proxy 127.0.0.1:8787
	}
}
