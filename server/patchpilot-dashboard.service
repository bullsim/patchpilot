# systemd unit for the PatchPilot dashboard. Install to:
#   /etc/systemd/system/patchpilot-dashboard.service
# then: sudo systemctl enable --now patchpilot-dashboard

[Unit]
Description=PatchPilot fleet dashboard
After=network.target

[Service]
Type=simple
# Adjust user and path to where you cloned the repo / copied server.js
User=patchpilot
WorkingDirectory=/opt/patchpilot/server
Environment=PORT=8787
Environment=DATA_DIR=/var/lib/patchpilot
ExecStart=/usr/bin/node /opt/patchpilot/server/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
