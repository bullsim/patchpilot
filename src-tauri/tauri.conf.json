{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PatchPilot",
  "version": "0.3.0",
  "identifier": "com.bullers.patchpilot",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PatchPilot",
        "width": 1080,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://patchpilot.bullers.com/updates/latest.json",
        "https://github.com/bullsim/patchpilot/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4Rjk4MUM4QkYyNEUwOTcKUldTWDRDUy95SUg1YUw2OC90OEZ1Z1BXYlQ5Ymw5L2FKTFE3bUZtMGJiMDk0M3JsZkMxQUpINEEK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
